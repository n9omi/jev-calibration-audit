# Copy to .env (never commit .env). Loaded automatically by the jev-audit CLI.

# Free key: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# TypeSafe (Jev)
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# LLM baseline: set the key for whichever provider your llm_* arm uses
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: trace every call in LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=jev-calibration-audit
